    "bones": {
        "hips": {
            "euler": [
                0,
                2.5,
                -5.5
            ],
            "why": "z: +5.5 raises the left (stance) crest — a positive roll about the forward axis lifts everything on the +X side. y: -2 takes the stance side very slightly back, which is the transverse component of a real weight shift."
        },
        "spine": {
            "euler": [
                0.5,
                -1.5,
                7.5
            ],
            "why": "The lumbar counter-bend, and the largest single number in the pose. It over-corrects the pelvis's 5.5 degrees so the net trunk lean ends up toward the stance side rather than away from it."
        },
        "chest": {
            "euler": [
                0.8,
                -0.8,
                3
            ],
            "why": "Carries the bend up. Sharing it across three spine bones is what makes a curve rather than a hinge."
        },
        "upperChest": {
            "euler": [
                1.2,
                0.8,
                -2
            ],
            "why": "Turns the curve back — the top of the S. Accumulated roll at the chest lands near -3 degrees, which is what tips the shoulder line opposite to the hip line."
        },
        "neck": {
            "euler": [
                2.2,
                -0.8,
                -2
            ],
            "why": "Brings the head back toward vertical."
        },
        "head": {
            "euler": [
                -1.6,
                0.7,
                -1.2
            ],
            "why": "Levels the eyes. A contrapposto with a tilted horizon reads as a stumble."
