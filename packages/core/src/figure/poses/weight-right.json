        "leftUpperLeg": {
            "euler": [
                -4,
                1,
                9
            ],
            "why": "Free leg. z: -9 undoes the pelvis roll and abducts the leg so the free foot ends up slightly wider than the stance foot. x: -4 flexes the hip, sending the knee forward — note that a bone pointing DOWN moves backward under a positive x rotation, which is the sign trap in this whole file."
        },
        "leftLowerLeg": {
            "euler": [
                8,
                0,
                0
            ],
            "why": "Free knee softly flexed to 14.8 degrees total. Positive x carries the shank back, which is where the heel goes when the knee bends and the foot stays put."
        },
