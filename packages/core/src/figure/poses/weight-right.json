        "rightUpperLeg": {
            "euler": [
                0,
                -5.5,
                8.5
            ],
            "why": "Stance leg. z: -8.5 undoes the pelvis's +5.5 roll and adds three degrees of adduction on top, which is what keeps the planted foot planted while the pelvis travels 40 mm over it."
        },
        "rightLowerLeg": {
            "euler": [
                0,
                0,
                0
            ],
            "why": "The stance knee stays where the bind pose has it. A knee carrying the load is close to straight."
