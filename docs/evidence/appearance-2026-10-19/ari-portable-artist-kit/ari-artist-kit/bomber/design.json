        "inside-pocket-connection-R",
        "inside-pocket-connection-L"
      ]
    },
    "B-R/B-L": {
      "meaning": "Two newly authored inside pocket-bag envelopes corresponding to mouth edges. Dashed perimeters propose attachment; no usable cut pattern, capacity or sewing feasibility.",
      "elements": [
        "inside-bag-R",
        "inside-bag-L"
      ]
    },
    "H": {
      "meaning": "Short gathered hem responsibility: two front ends, a continuous rear/profile strip, inside front ends and a larger shell/trim detail. Gather marks are graphic intent with no elastic ratio.",
