    "front": "Open jacket; wearer right is image-left. Both zip/pocket/cuff roles shown.",
    "profile": "Authored right side; front at image-left. Near P-R, Z-R and C-R; far roles hidden.",
    "rear": "Complete exterior rear proposal; no pocket or zipper marks.",
    "inside": "Smaller front-panel schematic only. Both facing/bag roles and left guard; sleeves/rear lining omitted.",
    "details": "Larger unjoined closure/facing/guard and gathered shell-to-hem proposal."
  },
  "features": {
    "Z-R/Z-L": {
      "meaning": "Two separately editable centre-front zipper edges, unjoined in open view. Bottom ends are graphic marks; engagement/separating mechanism unproved.",
