    },
    "G-L": {
      "meaning": "Authored guard behind the wearers left zipper edge; an inward proposal, not observed in Ari or the maker photo.",
      "elements": [
        "inside-guard-L",
        "detail-guard-L"
      ]
    },
    "P-R/P-L": {
      "meaning": "Exactly two slanted zip pocket mouths on the front, with one near P-R shown in right profile; far P-L hidden. Zip graphics express intent, not proved welt construction.",
      "elements": [
        "front-pocket-mouth-R",
        "front-pocket-zip-R",
        "front-pocket-mouth-L",
