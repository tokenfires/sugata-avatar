import { resolveHairColour, resolveHairTint, sameHairTint, mixedHairColour } from '../../core/src/material/HairColourOptions.js';

// Authored starting shades, not dye products. The material and room determine the rendered result.
export const HAIR_COLOURS = Object.freeze([
    ['Black', '#151217'], ['Brown', '#413934'], ['Auburn', '#4c3028'], ['Blonde', '#c7aa71'],
    ['Red', '#aa4029'], ['Grey', '#89868b'], ['White', '#e4dfd6']
].map(([label, hex]) => Object.freeze({label, hex})));

export function hairColourLabel(hex, tint) {
    const base = hex ? HAIR_COLOURS.find(c => c.hex === hex)?.label ?? hex : 'Original hair';
    return tint ? `${base} + ${Number((tint.amount * 100).toFixed(2))}% tint` : base;
}
export function hexToHsl(hex) {
    const rgb = [1, 3, 5].map(i => parseInt(hex.slice(i, i + 2), 16) / 255);
    const [r, g, b] = rgb, max = Math.max(...rgb), min = Math.min(...rgb), d = max - min;
    const l = (max + min) / 2;
    const h = d === 0 ? 0 : (max === r ? (g - b) / d + (g < b ? 6 : 0) : max === g ? (b - r) / d + 2 : (r - g) / d + 4) / 6;
    return {h, s: d === 0 ? 0 : d / (1 - Math.abs(2 * l - 1)), l};
}
export function hslToHex({h, s, l}) {
    const a = s * Math.min(l, 1 - l);
    const channel = n => {
        const k = (n + h * 12) % 12;
        return Math.round(255 * (l - a * Math.max(-1, Math.min(k - 3, 9 - k, 1)))).toString(16).padStart(2, '0');
    };
    return '#' + channel(0) + channel(8) + channel(4);
}

/** Local draft until Apply; navigation owns the fresh Avatar and preserves the other selections. */
export function mountHairColours(container, apply) {
    const shade = container.querySelector('#hair-shade'), picker = container.querySelector('#hair-colour');
    const lightness = container.querySelector('#hair-lightness'), amount = container.querySelector('#hair-lightness-value');
    const code = container.querySelector('#hair-colour-value'), status = container.querySelector('#hair-colour-status');
    const button = container.querySelector('#apply-hair-colour'), reset = container.querySelector('#reset-hair-colour');
    const tintEnabled = container.querySelector('#hair-tint-enabled'), tintPicker = container.querySelector('#hair-tint-colour');
    const tintAmount = container.querySelector('#hair-tint-amount'), tintValue = container.querySelector('#hair-tint-amount-value');
    const swatch = container.querySelector('#hair-colour-swatch');
    for (const colour of HAIR_COLOURS) shade.add(new Option(colour.label, colour.hex), shade.options[shade.options.length - 1]);
    let applied = null, draft = null, appliedTint = null, draftTint = null, hsl = hexToHsl('#765344');
    let rememberedTint = Object.freeze({colour: '#8063ac', amount: .25});
    let appliedDraft = null;
    function editorState() {
        return { shade: shade.value, base: picker.value, hsl: {...hsl}, rememberedTint,
            tintColour: tintPicker.value, tintAmount: tintAmount.value };
    }
    function refresh() {
        container.querySelector('#hair-tint-controls').hidden = draft === null;
        picker.disabled = lightness.disabled = draft === null;
        tintEnabled.disabled = draft === null;
        tintEnabled.checked = draftTint !== null;
        container.querySelector('#hair-tint-mix').hidden = draftTint === null;
        tintPicker.disabled = tintAmount.disabled = draftTint === null;
        if (draft !== null) picker.value = draft;
        lightness.value = String(Math.round(hsl.l * 100)); amount.textContent = `${lightness.value}%`;
        if (draftTint !== null) {
            tintPicker.value = draftTint.colour;
            tintAmount.value = String(draftTint.amount * 100);
        }
        tintValue.textContent = `${Number((Number(tintAmount.value)).toFixed(2))}%`;
        const mixed = mixedHairColour(draft, draftTint), unchanged = draft === applied && sameHairTint(draftTint, appliedTint);
        code.textContent = mixed ?? 'Original'; swatch.style.backgroundColor = mixed ?? 'transparent';
        button.disabled = unchanged;
        reset.disabled = !appliedDraft || (unchanged && JSON.stringify(editorState()) === JSON.stringify(appliedDraft));
        status.textContent = unchanged ? `Applied: ${hairColourLabel(applied, appliedTint)}` : 'Colour ready to apply';
    }
    shade.addEventListener('change', () => {
        draft = shade.value === 'original' ? null : shade.value === 'custom' ? picker.value : resolveHairColour(shade.value);
        if (draft === null) draftTint = null;
        if (draft !== null) hsl = hexToHsl(draft);
        refresh();
    });
    picker.addEventListener('input', () => { draft = resolveHairColour(picker.value); hsl = hexToHsl(draft); shade.value = 'custom'; refresh(); });
    lightness.addEventListener('input', () => { hsl.l = Number(lightness.value) / 100; draft = hslToHex(hsl); shade.value = 'custom'; refresh(); });
    tintEnabled.addEventListener('change', () => { draftTint = tintEnabled.checked ? rememberedTint : null; refresh(); });
    tintPicker.addEventListener('input', () => {
        rememberedTint = draftTint = resolveHairTint({colour: tintPicker.value, amount: rememberedTint.amount}, draft); refresh();
    });
    tintAmount.addEventListener('input', () => {
        rememberedTint = draftTint = resolveHairTint({colour: rememberedTint.colour, amount: Number(tintAmount.value) / 100}, draft); refresh();
    });
    button.addEventListener('click', () => { if (draft !== applied || !sameHairTint(draftTint, appliedTint)) apply(draft, draftTint); });
    reset.addEventListener('click', () => {
        if (!appliedDraft || reset.matches(':disabled')) return;
        draft = applied; draftTint = appliedTint;
        shade.value = appliedDraft.shade; picker.value = appliedDraft.base;
        hsl = {...appliedDraft.hsl}; rememberedTint = appliedDraft.rememberedTint;
        tintPicker.value = appliedDraft.tintColour; tintAmount.value = appliedDraft.tintAmount;
        refresh();
    });
    return { load(hex, tint) {
        applied = draft = hex ?? null;
        appliedTint = draftTint = resolveHairTint(tint, draft);
        if (draftTint !== null) rememberedTint = draftTint;
        shade.value = draft === null ? 'original' : HAIR_COLOURS.some(c => c.hex === draft) ? draft : 'custom';
        if (draft !== null) hsl = hexToHsl(draft);
        refresh();
        appliedDraft = editorState(); reset.disabled = true;
    } };
}
