import fs from 'node:fs'; import assert from 'node:assert/strict'; import {createHash} from 'node:crypto';
import {selectionFromConfiguration,showcaseSettingsUrl} from './packages/testbed/src/showcase-settings.mjs';
import {optionsForShowcase} from './packages/testbed/src/showcase-presets.mjs';
const p='docs/evidence/nonhair-2026-10-03/ink-denim-look', file=p+'/CANDIDATE.json', recipe=JSON.parse(fs.readFileSync(file));
assert.deepEqual(recipe,{identity:{gender:.5,mode:'nearest'},hair:'bob02',hairColour:'#413934',frame:'body',quality:'balanced',scene:'studio',lighting:'neutral',seed:20260807,pose:'relaxed-standing',wardrobe:{style:'ecru',colours:{top:'#32495e',bottom:'#35485c',shoes:'#48382e'},outfit:['female_casualsuit01','shoes01'],foundation:{TORSO:'foundation_bra',HIPS:'foundation_briefs'}}});
const variants=[];for(const scene of ['studio','kitchen'])for(const frame of ['body','portrait']){const r={...recipe,scene,frame};if(scene==='kitchen')delete r.lighting;const s=selectionFromConfiguration(r);assert.deepEqual(optionsForShowcase(s),r);variants.push({scene,frame,configuration:r,url:showcaseSettingsUrl(s,'http://127.0.0.1:5307/src/showcase.html?capture').href});}
const src=fs.readFileSync('tools/critic/ink-denim-look.mjs','utf8');for(const prohibited of ['resetFrameEpoch','frameId=','_animation','pixel','colorNode ='])assert.ok(!src.includes(prohibited),prohibited);
assert.ok(src.includes("t.slice(11)"));assert.equal('INK_RETIRE '.length,11);assert.ok(src.includes("await step('held', 72)"));assert.ok(src.includes("await step('released', 30)"));
const pins=Object.fromEntries([file,p+'/PLAN.md','tools/critic/ink-denim-look.mjs','packages/testbed/src/showcase.js','packages/testbed/src/showcase-settings.mjs','packages/testbed/src/showcase-presets.mjs','packages/testbed/src/viewer-scenes.mjs','packages/core/src/render/MotionProbe.mjs','packages/core/src/motion/AttentionAction.js'].map(f=>[f,createHash('sha256').update(fs.readFileSync(f)).digest('hex')]));
const r={time:new Date().toISOString(),pid:process.pid,command:'node --input-type=module stdin exact schema/source readback',status:'source-only',pins,variants,native:false};fs.writeFileSync(p+'/ROOT-SOURCE.json',JSON.stringify(r,null,2)+'\n');console.log(JSON.stringify({time:r.time,pid:process.pid,status:r.status,pins:Object.keys(pins).length,variants:variants.length,instrumentSHA256:pins['tools/critic/ink-denim-look.mjs']}));
