          "line": 42,
          "text": "@cached"
        },
        {
          "line": 43,
          "text": "def gather_joint_vnode(vnode, export_settings):"
        },
        {
          "line": 44,
          "text": "    \"\"\""
        },
        {
          "line": 45,
          "text": "    Generate a glTF2 node from a blender bone, as joints in glTF2 are simply nodes."
        },
        {
          "line": 46,
          "text": ""
        },
        {
          "line": 47,
          "text": "    :param blender_bone: a blender PoseBone"
        },
        {
          "line": 48,
          "text": "    :param export_settings: the settings for this export"
        },
        {
          "line": 49,
          "text": "    :return: a glTF2 node (acting as a joint)"
        },
        {
          "line": 50,
          "text": "    \"\"\""
        },
        {
          "line": 51,
          "text": "    vtree = export_settings['vtree']"
        },
        {
          "line": 52,
          "text": "    blender_bone = vtree.nodes[vnode].blender_bone"
        },
        {
          "line": 53,
          "text": ""
        },
        {
          "line": 54,
          "text": "    if export_settings['gltf_armature_object_remove'] is True:"
        },
        {
          "line": 55,
          "text": "        if vtree.nodes[vnode].parent_uuid is not None:"
        },
        {
          "line": 56,
          "text": "            mat = vtree.nodes[vtree.nodes[vnode].parent_uuid].matrix_world.inverted_safe("
        },
        {
          "line": 57,
          "text": "            ) @ vtree.nodes[vnode].matrix_world"
        },
        {
          "line": 58,
          "text": "        else:"
        },
        {
          "line": 59,
          "text": "            mat = vtree.nodes[vnode].matrix_world"
        },
        {
          "line": 60,
          "text": "    else:"
        },
        {
          "line": 61,
          "text": "        mat = vtree.nodes[vtree.nodes[vnode].parent_uuid].matrix_world.inverted_safe() @ vtree.nodes[vnode].matrix_world"
        },
        {
          "line": 62,
          "text": ""
        },
        {
          "line": 63,
          "text": "    trans, rot, sca = mat.decompose()"
        },
        {
          "line": 64,
          "text": ""
        },
        {
          "line": 65,
          "text": "    trans = __convert_swizzle_location(trans, export_settings)"
        },
        {
          "line": 66,
          "text": "    rot = __convert_swizzle_rotation(rot, export_settings)"
        },
        {
          "line": 67,
          "text": "    sca = __convert_swizzle_scale(sca, export_settings)"
        }
      ]
