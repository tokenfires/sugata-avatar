        {
          "line": 1388,
          "text": ""
        },
        {
          "line": 1389,
          "text": "        data = extract_attribute_data("
        },
        {
          "line": 1390,
          "text": "            self.blender_mesh.attributes[attr['blender_attribute_index']],"
