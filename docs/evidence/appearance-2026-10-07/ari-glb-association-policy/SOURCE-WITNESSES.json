        {
          "line": 61,
          "text": "def get_sk_exported(key_blocks):"
        },
        {
          "line": 62,
          "text": "    return ["
        },
        {
          "line": 63,
          "text": "        k"
        },
        {
          "line": 64,
          "text": "        for k in key_blocks"
        },
        {
          "line": 65,
          "text": "        if not skip_sk(key_blocks, k)"
        },
        {
          "line": 66,
          "text": "    ]"
        },
        {
          "line": 67,
          "text": ""
        },
        {
          "line": 68,
          "text": ""
        },
        {
          "line": 69,
          "text": "def skip_sk(key_blocks, k):"
        },
        {
          "line": 70,
          "text": "    # Do not export:"
        },
        {
          "line": 71,
          "text": "    # - if muted"
        },
        {
          "line": 72,
          "text": "    # - if relative key is SK itself (this avoid exporting Basis too if user didn't change order)"
        },
        {
          "line": 73,
          "text": "    # - the Basis (the first SK of the list)"
        },
        {
          "line": 74,
          "text": "    return k == k.relative_key \\"
        },
        {
          "line": 75,
          "text": "        or k.mute \\"
        },
        {
          "line": 76,
          "text": "        or is_first_index(key_blocks, k) is True"
        },
        {
          "line": 77,
          "text": ""
        },
        {
          "line": 78,
          "text": ""
        },
        {
          "line": 79,
          "text": "def is_first_index(key_blocks, k):"
        },
        {
          "line": 80,
          "text": "    return key_blocks[0].name == k.name"
        }
      ]
    },
