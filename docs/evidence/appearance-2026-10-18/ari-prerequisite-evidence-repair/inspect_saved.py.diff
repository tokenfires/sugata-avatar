+def validate_node_column(stop, stations):
+    """Bind a claimed nonboundary node to the affected column independently."""
+    axis = stop['axis']
+    assert type(axis) is int and 0 <= axis < 3
+    other = [a for a in range(3) if a != axis]
+    assert stop['other_axes'] == other and all(type(a) is int for a in stop['other_axes'])
+    column = stop['column_indices']
+    assert len(column) == 2 and all(type(i) is int for i in column)
+    assert all(0 <= column[k] < len(stations[a]) for k,a in enumerate(other))
+    node = stop['node']; idx = node['indices']
+    assert len(idx) == 3 and all(type(i) is int for i in idx)
+    assert all(0 <= idx[a] < len(stations[a]) for a in range(3))
+    assert [idx[a] for a in other] == column
+    assert type(node['strict_outside_axis']) is int and node['strict_outside_axis'] == axis
+    assert type(stop['scale_exponent']) is int and 0 <= stop['scale_exponent'] <= 149
+    assert node['scale_exponent'] == stop['scale_exponent']
+    return idx
 
 
