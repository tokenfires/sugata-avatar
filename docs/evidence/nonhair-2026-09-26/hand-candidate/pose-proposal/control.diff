+// Read-only witness. This never edits a contribution, cached frame or shared posture value.
+function verifyCandidateTelemetry(avatar, report) {
+    const posture = avatar.posture, gesture = avatar.gesture, radians = Math.PI / 180;
+    exact(posture.maxAdductionRadians, {leftUpperArm: 0, rightUpperArm: 0}, 'Fixed candidate budgets changed');
+    const intensity = posture.defects.ignoreIntensity === true ? 1 : posture.prescription.intensity;
+    const raw = POSTURE_FULL_SCALE_DEGREES.armSpread * radians * posture.prescription.armSpread * (intensity * posture.amplitude);
+    require(Number.isFinite(raw), 'Nonfinite native posture prescription');
+    const limited = raw >= 0 ? raw : Math.max(raw, -CANDIDATE_BUDGET.commonRadians);
+    exact(posture.appliedDegrees.armSpread, raw / radians, 'Native raw spread telemetry drift');
+    for (const [side, field] of [['leftUpperArm', 'armSpreadLeft'], ['rightUpperArm', 'armSpreadRight']]) {
+        exact(posture.appliedArmRadians[side], limited, 'Native applied radians disagree with fixed cap');
+        exact(posture.appliedDegrees[field], limited / radians, 'Native applied spread telemetry disagrees with fixed cap');
+    }
+    const sampled = report.completedFrames > 0;
+    if (sampled) require(report.samples?.posture && report.samples?.gesture && Array.isArray(report.owners) && Number.isInteger(report.frame), 'Missing sampled native owner state');
+    else require(report.completedFrames === 0 && report.samples === null && report.owners === null && report.frame === null, 'Unexpected pre-first-frame owner state');
+    for (const owner of report.owners ?? []) if (owner.status === 'returned-output') exact(owner.raw, owner.effective, 'Candidate must not filter native owner output');
+    const activeGesture = sampled && report.samples.gesture.status === 'returned-output';
+    const expectedYield = postureYield(posture.appliedDegrees.armSpreadLeft);
+    if (activeGesture) exact(gesture.applied.yield, expectedYield, 'Native Gesture yield disagrees with actual shared posture');
+    return {phase: sampled ? 'sampled-native-frame' : 'before-first-instrumented-frame', frame: report.frame, existingStackFrame: avatar.stack.frame, budget: {...posture.maxAdductionRadians}, rawArmSpreadRadians: raw,
+        appliedArmRadians: {...posture.appliedArmRadians}, activeGesture, observedGestureYield: activeGesture ? gesture.applied.yield : null,
+        expectedGestureYield: activeGesture ? expectedYield : null, outputFiltering: false};
